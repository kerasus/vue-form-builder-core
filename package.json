{
  "name": "vue-form-builder-core",
  "version": "0.0.1",
  "description": "Headless and schema-driven form builder engine for Vue 3.",
  "type": "module",
  "main": "./dist/vue-form-builder-core.umd.cjs",
  "module": "./dist/vue-form-builder-core.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-form-builder-core.js",
      "require": "./dist/vue-form-builder-core.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "vue",
    "vue3",
    "form",
    "form-builder",
    "schema-form",
    "dynamic-forms",
    "headless-form"
  ],
  "author": {
    "name": "Ali Esmaeeli",
    "email": "aliesmaeeli20@gmail.com",
    "url": "https://github.com/kerasus"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kerasus/vue-form-builder-core.git"
  },
  "bugs": {
    "url": "https://github.com/kerasus/vue-form-builder-core/issues"
  },
  "homepage": "https://github.com/kerasus/vue-form-builder-core#readme",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build --mode production",
    "preview": "vite preview",
    "lint": "eslint --fix --ext .js,.ts,.vue src"
  },
  "dependencies": {
    "shvl": "^3.0.1"
  },
  "peerDependencies": {
    "vue": "^3.3.0 || ^3.4.0 || ^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.57.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-vue": "^9.23.0",
    "postcss": "^8.4.32",
    "postcss-rtlcss": "^4.0.9",
    "sass-embedded": "^1.103.1",
    "typescript": "^5.4.0",
    "vite": "^5.2.6",
    "vite-plugin-dts": "^3.8.0",
    "vue": "^3.5.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
